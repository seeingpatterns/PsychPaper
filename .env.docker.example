# Local docker env template
# Copy to .env.docker and replace placeholders with local secrets.

# Server
NODE_ENV=development
PORT=3000
SESSION_SECRET=<generate-random-64-char-string>
# NOTE: URL userinfo requires percent-encoding for special characters.
DATABASE_URL=postgresql://<user>:<password>@db:5432/psychpaper
CORS_ORIGIN=http://localhost:8080

# Database
POSTGRES_USER=<user>
POSTGRES_PASSWORD=<strong-random-password>
POSTGRES_DB=psychpaper
