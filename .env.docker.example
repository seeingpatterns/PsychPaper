# Local docker env template
# Copy to .env.docker and replace placeholders with local secrets.

# Server
NODE_ENV=development
PORT=3000
SESSION_SECRET=<generate-random-64-char-string>
# NOTE: URL userinfo requires percent-encoding for special characters.
# App role from db-schema/11_db_roles.sql (not the bootstrap POSTGRES_USER).
DATABASE_URL=postgresql://psychpaper_app:<app-password>@db:5432/psychpaper
CORS_ORIGIN=http://localhost:8080

# Database bootstrap (init volume / CREATE ROLE only — do not use as app DATABASE_URL)
POSTGRES_USER=<bootstrap-user>
POSTGRES_PASSWORD=<strong-random-password>
POSTGRES_DB=psychpaper
